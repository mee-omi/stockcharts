# ─── Market data provider ────────────────────────────────────────────────
# mock       = built-in synthetic NSE data (no credentials needed) [DEFAULT]
# zerodha    = Zerodha history via PyZData + enctoken; live prices by polling 1m bars
# kiteticker = Zerodha official Kite Connect: history + KiteTicker websocket
#              (needs ZERODHA_API_KEY + ZERODHA_ACCESS_TOKEN below; token renews daily)
# angelone   = Angel One SmartAPI: history + SmartWebSocket V2 (needs ANGELONE_* below)
MARKET_DATA_PROVIDER=mock

# Required only when MARKET_DATA_PROVIDER=zerodha.
# Get it from kite.zerodha.com → DevTools → Application → Cookies → enctoken
ENCTOKEN=

# ─── Service wiring ──────────────────────────────────────────────────────
DATA_SERVICE_URL=http://localhost:8000
DATA_SERVICE_PORT=8000
BACKEND_PORT=8080
FRONTEND_PORT=5173

# ─── Database (TimescaleDB / PostgreSQL) ─────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stockcharts
POSTGRES_USER=stockcharts
POSTGRES_PASSWORD=stockcharts

# ─── Alerts (optional delivery channels) ─────────────────────────────────
# Telegram: create a bot with @BotFather, then get your chat id (e.g. via @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Any URL that should receive a JSON POST for every fired alert.
ALERTS_WEBHOOK_URL=

# ─── Operations ──────────────────────────────────────────────────────────
# Structured logs: BACKEND_PROFILES=json (Spring profile), LOG_FORMAT=json (data service).
BACKEND_PROFILES=
LOG_FORMAT=
# Rate limits per client per minute (general / order placement / screener+backtest).
RATE_LIMIT_RPM=600
RATE_LIMIT_TRADING_RPM=60
RATE_LIMIT_HEAVY_RPM=30
RATE_LIMIT_AUTH_RPM=10

# ─── Login ───────────────────────────────────────────────────────────────
# The first visit asks you to create the (single) account. Sessions last AUTH_SESSION_TTL.
AUTH_ENABLED=true
# Session signing key (32+ random chars). Empty = generated once and stored in the database.
AUTH_SECRET=
AUTH_SESSION_TTL=P7D
# true when the app is served over HTTPS (also detected from X-Forwarded-Proto).
AUTH_COOKIE_SECURE=false
# Extra browser origins allowed to call the API / WebSocket (comma-separated). Same-origin always works.
ALLOWED_ORIGINS=

# ─── Broker credentials (market data and/or trading) ─────────────────────
# Zerodha Kite Connect (developers.kite.trade): api key + today's access token.
ZERODHA_API_KEY=
ZERODHA_ACCESS_TOKEN=
# Angel One SmartAPI: API key, client id, account MPIN, and the TOTP secret (base32) shown when
# enabling TOTP for SmartAPI. The session renews itself daily and on expiry.
ANGELONE_API_KEY=
ANGELONE_CLIENT_ID=
ANGELONE_PIN=
ANGELONE_TOTP_SECRET=

# ─── Live feed & history sync ────────────────────────────────────────────
# Stream real brokers only 09:15–15:30 IST on trading days; add NSE holidays (YYYY-MM-DD, comma separated).
LIVE_MARKET_HOURS_ONLY=true
NSE_HOLIDAYS=
# The mock market follows the NSE session; true = 24/7 (e.g. to watch live ticks in the evening).
MOCK_ALWAYS_OPEN=false
# Daily download after the close (15:45 IST) + at startup: timeframe:lookback-days pairs,
# for watchlist symbols + these index universes.
HISTORY_SYNC_ENABLED=true
HISTORY_SYNC_TIMEFRAMES=1d:1825,15m:120,1m:30
HISTORY_SYNC_INDICES=NIFTY50
