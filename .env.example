# ─── Market data provider ────────────────────────────────────────────────
# mock    = built-in synthetic NSE data (no credentials needed) [DEFAULT]
# zerodha = real live/historical data via PyZData + Zerodha enctoken
MARKET_DATA_PROVIDER=mock

# Required only when MARKET_DATA_PROVIDER=zerodha.
# Get it from kite.zerodha.com → DevTools → Application → Cookies → enctoken
ENCTOKEN=

# ─── Service wiring ──────────────────────────────────────────────────────
DATA_SERVICE_URL=http://localhost:8000
DATA_SERVICE_PORT=8000
BACKEND_PORT=8080
FRONTEND_PORT=5173

# ─── Database (TimescaleDB / PostgreSQL) ─────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stockcharts
POSTGRES_USER=stockcharts
POSTGRES_PASSWORD=stockcharts

# ─── Alerts (optional delivery channels) ─────────────────────────────────
# Telegram: create a bot with @BotFather, then get your chat id (e.g. via @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Any URL that should receive a JSON POST for every fired alert.
ALERTS_WEBHOOK_URL=

# ─── Operations ──────────────────────────────────────────────────────────
# Structured logs: BACKEND_PROFILES=json (Spring profile), LOG_FORMAT=json (data service).
BACKEND_PROFILES=
LOG_FORMAT=
# Rate limits per client per minute (general / order placement / screener+backtest).
RATE_LIMIT_RPM=600
RATE_LIMIT_TRADING_RPM=60
RATE_LIMIT_HEAVY_RPM=30
